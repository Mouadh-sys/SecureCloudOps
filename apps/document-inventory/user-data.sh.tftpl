#!/bin/bash
set -euo pipefail

command -v python3 >/dev/null
command -v curl >/dev/null
mkdir -p /opt/securecloudops /var/log/securecloudops /opt/aws/amazon-cloudwatch-agent/etc
printf '%s' "${app_source_base64}" | base64 --decode > /opt/securecloudops/app.py
chmod 0644 /opt/securecloudops/app.py
id -u securecloudops >/dev/null 2>&1 || useradd --system --no-create-home --shell /sbin/nologin securecloudops
chown securecloudops:securecloudops /var/log/securecloudops

curl --fail --silent --show-error --location \
  https://amazoncloudwatch-agent.s3.amazonaws.com/amazon_linux/amd64/latest/amazon-cloudwatch-agent.rpm \
  --output /tmp/amazon-cloudwatch-agent.rpm
rpm -U /tmp/amazon-cloudwatch-agent.rpm
rm -f /tmp/amazon-cloudwatch-agent.rpm

cat > /etc/systemd/system/securecloudops-inventory.service <<'UNIT'
[Unit]
Description=SecureCloudOps synthetic document inventory
After=network.target

[Service]
Type=simple
User=securecloudops
Group=securecloudops
Environment=APP_LOG_PATH=/var/log/securecloudops/application.log
ExecStart=/usr/bin/python3 /opt/securecloudops/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/securecloudops

[Install]
WantedBy=multi-user.target
UNIT

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWCONFIG'
{
  "agent": {
    "region": "${region}"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/securecloudops/application.log",
            "log_group_name": "${log_group_name}",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
CWCONFIG

systemctl daemon-reload
systemctl enable --now securecloudops-inventory.service
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
  -s
